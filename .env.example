# Puerto del servidor local (por defecto 4331)
NOVACUT_PORT=4331

# Carpeta de datos (proyectos, medios, exports). Por defecto ./data
# NOVACUT_DATA_DIR=C:\ruta\a\novacut-data

# Ruta de ffmpeg/ffprobe. Por defecto se resuelve desde PATH.
# NOVACUT_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# NOVACUT_FFPROBE=C:\ffmpeg\bin\ffprobe.exe

# ------------------------------------------------------------------ IA
# La forma recomendada es configurar el proveedor desde Ajustes → Agente de IA.
# Esas opciones se guardan en data/ai-settings.json y tienen prioridad sobre
# estas variables. Usa .env como alternativa para despliegues sin interfaz.
#
# NVIDIA NIM (gratis, sin transcripción de audio):
# NOVACUT_AI_BASE_URL=https://integrate.api.nvidia.com/v1
# NOVACUT_AI_API_KEY=nvapi-...
# NOVACUT_AI_MODEL=openai/gpt-oss-20b
# NOVACUT_AI_TRANSCRIBE_MODEL=
#
# OpenAI (chat + Whisper):
# NOVACUT_AI_BASE_URL=https://api.openai.com/v1
# NOVACUT_AI_API_KEY=sk-...
# NOVACUT_AI_MODEL=gpt-4o-mini
# NOVACUT_AI_TRANSCRIBE_MODEL=whisper-1
#
# Groq (rápido, con Whisper):
# NOVACUT_AI_BASE_URL=https://api.groq.com/openai/v1
# NOVACUT_AI_API_KEY=gsk_...
# NOVACUT_AI_MODEL=llama-3.3-70b-versatile
# NOVACUT_AI_TRANSCRIBE_MODEL=whisper-large-v3-turbo
#
# Ollama local (no necesita clave):
# NOVACUT_AI_BASE_URL=http://127.0.0.1:11434/v1
# NOVACUT_AI_MODEL=llama3.2
# NOVACUT_AI_TRANSCRIBE_MODEL=
#
# Cualquier endpoint compatible con OpenAI:
# NOVACUT_AI_BASE_URL=https://mi-proveedor/v1
# NOVACUT_AI_API_KEY=...
# NOVACUT_AI_MODEL=...
# NOVACUT_AI_TRANSCRIBE_MODEL=
# NOVACUT_AI_TIMEOUT_MS=120000

# ------------------------------------------------------------------ MCP
# El endpoint MCP ya está integrado en el servidor principal: /mcp
# Opcional: exige Authorization: Bearer <token> a los clientes MCP.
# NOVACUT_MCP_TOKEN=un-token-largo-y-aleatorio
#
# Servidor MCP HTTP independiente (opcional, por defecto 4332).
# NOVACUT_MCP_PORT=4332
# NOVACUT_MCP_HOST=127.0.0.1
#
# URL pública si usas un túnel (Cloudflare, ngrok) para ChatGPT:
# NOVACUT_MCP_URL=https://mi-tunel.example.com/mcp

# Codificador de exportación: auto | cpu | nvidia
NOVACUT_ENCODER=auto

# Límite de subida por archivo en MB (por defecto 4096)
NOVACUT_MAX_UPLOAD_MB=4096

# Nombre de marca configurable
NOVACUT_BRAND=NOVACUT AI
